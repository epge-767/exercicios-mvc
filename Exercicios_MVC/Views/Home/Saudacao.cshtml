@{
    if(ViewBag.Nome != null)
    {
        <h1>Olá, @ViewBag.Nome.</h1>
    }
    else
    {
        <form asp-action="Saudacao" method="post">
            <label for="nome">Qual é o teu nome?</label>
            <input type="text" id="nome" name="id" value="@ViewBag.Nome"/>
            <input type="submit" value="Enviar" />
        </form>
    }
}
